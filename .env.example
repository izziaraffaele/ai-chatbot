AUTH_SECRET=3440dd8f96b1e8911d1f45d7b9ac1d70

# ==============================================================================
# WHITE-LABEL BRANDING CONFIGURATION
# ==============================================================================
# These environment variables provide default values for the branding system.
# They are merged with the demo config in this order:
#   1. Schema defaults (in code)
#   2. Environment variables (below)
#   3. Demo config overrides (via demo panel or persistence)
#
# All variables are OPTIONAL. If not set, the system uses sensible defaults.

# ------------------------------------------------------------------------------
# Application Identity
# ------------------------------------------------------------------------------
# Used throughout the application for branding and navigation

NEXT_PUBLIC_APP_NAME="Chat SDK"
# The name of your application (used in titles, navigation)

NEXT_PUBLIC_APP_DESCRIPTION="Next.js chatbot template using the AI SDK."
# Brief description of your application

NEXT_PUBLIC_APP_URL="https://chat.vercel.ai"
# The base URL of your deployed application (used for metadata and links)

# ------------------------------------------------------------------------------
# Organization Branding
# ------------------------------------------------------------------------------
# Information about the organization/company behind the application

NEXT_PUBLIC_ORGANIZATION_NAME=""
# Optional: Your organization/company name

NEXT_PUBLIC_ORGANIZATION_DESCRIPTION=""
# Optional: Brief description of your organization

NEXT_PUBLIC_ORGANIZATION_URL=""
# Optional: Your organization's website URL

# ------------------------------------------------------------------------------
# Assistant Configuration
# ------------------------------------------------------------------------------
# Customize the AI assistant's identity and appearance

NEXT_PUBLIC_ASSISTANT_NAME=""
# Optional: Name for the AI assistant (default: "Assistant")

NEXT_PUBLIC_ASSISTANT_DESCRIPTION=""
# Optional: Brief description of the assistant

NEXT_PUBLIC_ASSISTANT_AVATAR_URL=""
# Optional: URL to the assistant's avatar image

# ------------------------------------------------------------------------------
# Visual Assets (Logos and Images)
# ------------------------------------------------------------------------------
# URLs to images used for branding throughout the application

NEXT_PUBLIC_LOGO_URL=""
# Optional: Main logo displayed in navigation and sidebar

NEXT_PUBLIC_AUTH_LOGO_URL=""
# Optional: Logo displayed on authentication pages (login/register)
# Falls back to NEXT_PUBLIC_LOGO_URL if not set

NEXT_PUBLIC_FAVICON_URL=""
# Optional: Browser favicon (dynamically updated via client-side JS)

NEXT_PUBLIC_OG_IMAGE_URL=""
# Optional: Open Graph image for social media sharing

# ------------------------------------------------------------------------------
# Theme Customization
# ------------------------------------------------------------------------------
# Control the visual theme and styling

NEXT_PUBLIC_THEME_PRESET=""
# Optional: Theme preset (default | playful | tech)

NEXT_PUBLIC_DEFAULT_THEME_MODE=""
# Optional: Default theme mode (dark | light | auto)

NEXT_PUBLIC_CUSTOM_CSS=""
# Optional: Custom CSS variables for advanced theming
# Example: "--primary: 220 90% 56%; --radius: 0.5rem;"

# ------------------------------------------------------------------------------
# Internationalization (i18n)
# ------------------------------------------------------------------------------
# Configure language and localization settings for the application

NEXT_PUBLIC_DEFAULT_LOCALE="en"
# Default language for the application (en | it | ...)
# Used when no language preference is stored in user cookies

NEXT_PUBLIC_SUPPORTED_LOCALES="en,it"
# Comma-separated list of supported language codes
# These languages will be available in the language switcher
# Example: "en,it,es,fr,de" for English, Italian, Spanish, French, German

# ------------------------------------------------------------------------------
# Metadata (SEO and Social Sharing)
# ------------------------------------------------------------------------------
# Used for page metadata, search engines, and social media

NEXT_PUBLIC_METADATA_TITLE="Next.js Chatbot Template"
# Page title shown in browser tabs and search results

NEXT_PUBLIC_METADATA_DESCRIPTION="Next.js chatbot template using the AI SDK."
# Meta description for SEO

# ------------------------------------------------------------------------------
# Services
# ------------------------------------------------------------------------------

NEXT_PUBLIC_AVATAR_SERVICE_URL="https://avatar.vercel.sh/{email}"
# Avatar service URL template. Use {email} placeholder for dynamic substitution.
# Example: "https://avatar.vercel.sh/{email}"
# Example: "https://ui-avatars.com/api/?name={email}"

NEXT_PUBLIC_SUPPORT_URL=""
# Optional: URL for user support or help documentation

# ------------------------------------------------------------------------------
# Analytics and Telemetry
# ------------------------------------------------------------------------------

NEXT_PUBLIC_TELEMETRY_SERVICE_NAME=""
# Optional: Name for telemetry service tracking

NEXT_PUBLIC_GA_ID=""
# Optional: Google Analytics tracking ID

NEXT_PUBLIC_ENABLE_TELEMETRY="true"
# Enable/disable telemetry collection (true | false)

# ------------------------------------------------------------------------------
# Development Tools
# ------------------------------------------------------------------------------

# NEXT_PUBLIC_ENABLE_BRANDING_PANEL=""
# WARNING: Do NOT enable in production!
# When set to "true", displays a floating settings button for real-time branding preview.
# This panel is for development and demo purposes only.

# The following keys below are automatically created and
# added to your environment when you deploy on Vercel

# Instructions to create an AI Gateway API key here: https://vercel.com/ai-gateway
# API key required for non-Vercel deployments
# For Vercel deployments, OIDC tokens are used automatically
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=****


# Instructions to create a Vercel Blob Store here: https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# Instructions to create a PostgreSQL database here: https://vercel.com/docs/postgres
POSTGRES_URL=****


# Instructions to create a Redis store here:
# https://vercel.com/docs/redis
REDIS_URL=****
OPENAI_API_KEY=your-api-key
OPENAI_API_KEY=your-api-key
